import java.util.*;
class Solution {
    public static boolean checkEqual(int[] a, int[] b) {
        int n1=a.length;int n2=b.length;
        Arrays.sort(a);
        Arrays.sort(b);
        int flag=0;
        if(n1==n2){
            for(int i=0;i<n1;i++){
                if(a[i]!=b[i]){
                    flag=1;
                }
            }
        }
        
        if(flag==0) return true;
        else return false;
    }
}
