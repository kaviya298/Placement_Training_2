import java.util.*;
class Solution {
    public void sort012(int[] arr) {
        int n=arr.length;
        int count0=0;int count1=0;int count2=0;
        for(int i=0;i<n;i++){
            if(arr[i]==0) count0++;
            else if(arr[i]==1) count1++;
            else if(arr[i]==2) count2++;
        }
        int i=0;
        while(count0-->0) arr[i++]=0;
        while(count1-->0) arr[i++]=1;
        while(count2-->0) arr[i++]=2;
    }
}
