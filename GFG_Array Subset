class Solution {
    public boolean isSubset(int a[], int b[]) {
        int n1=a.length;
        int n2=b.length;
        Arrays.sort(a);
        Arrays.sort(b);
        int i=0;int j=0;
        while(i<n1 && j<n2){
            if(a[i]==b[j]){
                i++;j++;
            }
            else if(a[i]<b[j]){
                i++;
            }
            else{
                return false;
            }
        }
        return (j==n2);
    }
}
