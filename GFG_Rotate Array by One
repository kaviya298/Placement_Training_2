import java.util.*;
class Solution {
    public void rotate(int[] arr) {
        int n=arr.length;
        reverse(arr,0,n-1);
        reverse(arr,1,n-1);
    }
        public void reverse(int arr[],int start,int end){
          while(start<end){
            int temp=arr[start];
            arr[start]=arr[end];
            arr[end]=temp;
            start++;
            end--;
        } 
        }
}

//or

class Solution {
    public void rotate(int[] arr) {
        int n=arr.length;
        int last=arr[n-1];
        for(int i=n-1;i>0;i--){
            arr[i]=arr[i-1];
        }
        arr[0]=last;
    }
}
